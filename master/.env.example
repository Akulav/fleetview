# FleetView master configuration. Copy to .env and adjust.
# Never commit .env or the data folder: they hold the keys to every PC.

# Where people open the console (used for secure cookies and links).
FLEETVIEW_PUBLIC_URL=https://fleetview.akulav.com

# The web console. Keep it on loopback and put a reverse proxy with HTTPS in
# front (see README). Or set FLEETVIEW_HTTPS_CERT / FLEETVIEW_HTTPS_KEY.
# Hosts that set PORT / HOST / DATA_DIR (AutoNode, …) are honoured when the
# FLEETVIEW_ variables below are not set.
# FLEETVIEW_HTTP_HOST=127.0.0.1
# FLEETVIEW_HTTP_PORT=8080
# FLEETVIEW_HTTPS_CERT=/etc/letsencrypt/live/fleetview.akulav.com/fullchain.pem
# FLEETVIEW_HTTPS_KEY=/etc/letsencrypt/live/fleetview.akulav.com/privkey.pem

# Console login. Generate the hash with `npm run hash-password`.
# Without it, a random password is generated on first start and printed once.
FLEETVIEW_ADMIN_USER=admin
FLEETVIEW_ADMIN_PASSWORD_HASH=
FLEETVIEW_SESSION_HOURS=12

# Agents connect here over pinned TLS (raw TCP — it cannot go through an HTTP
# proxy; open/forward this port to the master).
FLEETVIEW_AGENT_HOST=0.0.0.0
FLEETVIEW_AGENT_PORT=48620
# Address baked into new agent installers. Empty = agents find the master by
# LAN broadcast (only works when the master is on the same network).
# FLEETVIEW_AGENT_ADDRESS=fleetview.akulav.com:48620
FLEETVIEW_DISCOVERY=true

# Data folder (identity, PCs, jobs, uploaded installers, logs). Back it up.
# FLEETVIEW_DATA_DIR=data
# FLEETVIEW_MASTER_NAME=FleetView ANSC
# FLEETVIEW_EMANAGEMENT_URL=https://docs.example.md
FLEETVIEW_MAX_UPLOAD_MB=2048
FLEETVIEW_PARALLEL_TRANSFERS=4
